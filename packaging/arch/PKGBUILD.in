# Rendered by scripts/package-arch.py with this release's pinned checksums.
pkgname=rex-rune-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native Linux client for existing Rex terminal servers'
arch=('x86_64' 'aarch64')
url='https://github.com/shuv1337/rex-rune'
license=('MIT')
# rex-linux-bin is this package before the rename: pacman offers the replacement on the
# next -Syu, and the old names still resolve to it for anything that asks for them.
provides=('rex-rune' 'rex-linux' "rex-linux-bin=${pkgver}")
conflicts=('rex-rune' 'rex-linux' 'rex-linux-bin')
replaces=('rex-linux-bin')
depends=('glibc>=2.39' 'gcc-libs' 'fontconfig' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'libx11' 'libxcb' 'libglvnd' 'vulkan-icd-loader'
         'xdg-utils' 'ca-certificates' 'hicolor-icon-theme')
# The package works without it; with it, Settings can run the update helper below.
optdepends=('polkit: Update now in Settings, without a terminal')
options=('!strip' '!debug')
source_x86_64=("https://github.com/shuv1337/rex-rune/releases/download/v${pkgver}/rex-rune-${pkgver}-x86_64-linux-gnu.tar.gz")
source_aarch64=("https://github.com/shuv1337/rex-rune/releases/download/v${pkgver}/rex-rune-${pkgver}-aarch64-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

# The package-signing certificate, as the update helper reads it, and its primary key. Done
# here and not in package(), which runs under fakeroot.
build() {
    cd "rex-rune-${pkgver}-${CARCH}-linux-gnu"
    local gnupg
    gnupg=$(mktemp -d)
    gpg --homedir "$gnupg" --no-autostart --batch --show-keys --with-colons resources/pacman/archive-key.asc \
        | awk -F: '$1 == "fpr" { print $10; exit }' > "$srcdir/archive-key.primary"
    gpg --homedir "$gnupg" --no-autostart --batch --dearmor < resources/pacman/archive-key.asc > "$srcdir/archive-key.gpg"
    rm -rf "$gnupg"
    [[ $(< "$srcdir/archive-key.primary") =~ ^[0-9A-F]{40}$ ]]
    [[ -s $srcdir/archive-key.gpg ]]
}

package() {
    cd "rex-rune-${pkgver}-${CARCH}-linux-gnu"
    install -Dm755 bin/rex-rune "$pkgdir/usr/bin/rex-rune"
    # The old command keeps working for scripts and key bindings.
    ln -s rex-rune "$pkgdir/usr/bin/rex-linux"
    install -Dm644 resources/dev.shuv.rex-rune.desktop "$pkgdir/usr/share/applications/dev.shuv.rex-rune.desktop"
    for size in 32 128 256; do
        install -Dm644 "resources/icons/${size}x${size}/apps/dev.shuv.rex-rune.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/dev.shuv.rex-rune.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -r licenses "$pkgdir/usr/share/licenses/$pkgname/dependencies"
    install -Dm644 BUILD-INFO "$pkgdir/usr/share/doc/rex-rune/BUILD-INFO"
    install -dm755 "$pkgdir/usr/share/rex-rune"
    printf 'channel=pacman\nhint=sudo pacman -Syu\n' > "$pkgdir/usr/share/rex-rune/channel"
    # "Update now" for this package: the one program polkit may run as root, the action
    # that lets it, and the certificate it checks a downloaded package against. The
    # certificate's primary key is written into the helper, so a signature must name it.
    install -Dm755 resources/pacman/rex-rune-update "$pkgdir/usr/lib/rex-rune/rex-rune-update"
    install -Dm644 resources/pacman/dev.shuv.rex-rune.update.policy \
        "$pkgdir/usr/share/polkit-1/actions/dev.shuv.rex-rune.update.policy"
    local primary
    primary=$(< "$srcdir/archive-key.primary")
    install -Dm644 "$srcdir/archive-key.gpg" "$pkgdir/usr/share/rex-rune/archive-key.gpg"
    sed -i "s/@PRIMARY@/$primary/" "$pkgdir/usr/lib/rex-rune/rex-rune-update"
    grep -qx "readonly PRIMARY='$primary'" "$pkgdir/usr/lib/rex-rune/rex-rune-update"
}
