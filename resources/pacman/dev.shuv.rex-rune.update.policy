<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Rex Rune's "Update now" for pacman installs. This lets someone at this computer, after
  giving an administrator's password, run one program as root:
  /usr/lib/rex-rune/rex-rune-update, which upgrades the rex-rune-bin package to a newer
  release signed by the Rex package key and does nothing else.

  It asks every time (auth_admin, not auth_admin_keep), and only for a local, active
  session. Nothing here answers yes without a password; an administrator who wants that
  writes their own rule. docs/plans/pacman-update-now.md has the reasoning.
-->
<policyconfig>
  <vendor>Rex Rune</vendor>
  <vendor_url>https://github.com/shuv1337/rex-rune</vendor_url>
  <action id="dev.shuv.rex-rune.update">
    <description>Update Rex Rune</description>
    <message>Authentication is required to update Rex Rune</message>
    <icon_name>dev.shuv.rex-rune</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/rex-rune/rex-rune-update</annotate>
  </action>
</policyconfig>
